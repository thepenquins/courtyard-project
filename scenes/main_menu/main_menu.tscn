script = ExtResource("4_4xg86")
developers = PackedStringArray("Наша семья переехала в новостройку с внутренним двором. Нас всегда было трое: я, моя сестра, моя мать и наш сосед. ...Погодите, что? Зачем он лезет в нашу жизнь? Почему смотрит из окна напротив? Как в нашей квартире что-то меняется? И жив ли сосед? Или за нами следит что-то... неживое?        Каждый двор-колодец имеет двойное дно.", "O3ZY", "RANKEL", "lexander", "Даня Балахнин", "LehanFox")
separator = "                              "
speed = 120.0
spacing = 120.0
pause_on_hover = false
font = ExtResource("5_thkx5")
text_color = Color(1, 1, 1, 0.6862745)

